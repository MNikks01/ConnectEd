{
  "__comment": "Dashboard 2 of .docs/Monitoring/01-slos-and-alerts.md \u2014 pool occupancy and the query latency the API sees. Edited as code; Grafana UI edits are discarded on restart. Replication lag and slow-query counts are absent deliberately: nothing exports them yet, and an empty panel reads as a healthy database rather than as a missing exporter.",
  "uid": "connected-database",
  "title": "ConnectEd \u2014 Database",
  "tags": ["connected", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Connections in use",
      "description": "Checked out of the pool right now.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "red",
                "value": 9
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(db_pool_connections{state=\"in_use\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Waiting for a connection",
      "description": "Requests queueing for a free connection. Anything sustained above zero is pool exhaustion, which looks exactly like a slow database from the outside.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(db_pool_connections{state=\"waiting\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pool size",
      "description": "Connections the pool has opened.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(db_pool_connections{state=\"total\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Idle",
      "description": "Open and unused. A pool that is always idle is larger than it needs to be.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(db_pool_connections{state=\"idle\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pool occupancy",
      "description": "The shape to look for: `waiting` rising while `in_use` sits flat at the pool size.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(db_pool_connections{state=\"in_use\"})",
          "legendFormat": "in use"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum(db_pool_connections{state=\"idle\"})",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "sum(db_pool_connections{state=\"waiting\"})",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency, by percentile",
      "description": "Not a database metric, and here on purpose: it is the thing pool exhaustion moves, so the two belong on one screen.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Slow and failing queries",
      "description": "Prisma warnings and errors. The API does not export a slow-query counter; this is the nearest honest thing until Postgres itself is scraped.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "{service=\"connected-api\"} |= \"prisma\" | json | level >= 40",
          "queryType": "range"
        }
      ]
    }
  ]
}
