{
  "__comment": "Dashboard 4 of .docs/Monitoring/01-slos-and-alerts.md \u2014 onboarding, verification, publishing, and notification latency. Edited as code; Grafana UI edits are discarded on restart. Every panel is derived from signals the API already emits: request counters by route and status, and the domain events the worker fans out. Nothing here needs a second pipeline, which is why it exists at all rather than waiting for one.",
  "uid": "connected-business",
  "title": "ConnectEd \u2014 Business",
  "tags": ["connected", "business"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Registrations (1h)",
      "description": "Individuals and schools, successful only.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(http_request_duration_seconds_count{route=~\"/auth/register.*\",status=\"201\"}[1h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Verification decisions (1h)",
      "description": "Approvals and rejections. The product's central workflow.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(domain_events_processed_total{type=\"verification.decided\",result=\"ok\"}[1h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Academic items published (1h)",
      "description": "Homework, assignments, projects.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(domain_events_processed_total{type=\"academic.published\",result=\"ok\"}[1h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Fan-out latency, median",
      "description": "SLO: publish \u2192 notification under 10 seconds at the median.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(domain_event_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "The onboarding funnel",
      "description": "Registration \u2192 request \u2192 decision. A gap that widens between the second and third line is a school that has stopped reviewing its queue, which no error rate would show.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(http_request_duration_seconds_count{route=~\"/auth/register.*\",status=\"201\"}[15m]))",
          "legendFormat": "registered"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum(rate(domain_events_processed_total{type=\"verification.submitted\",result=\"ok\"}[15m]))",
          "legendFormat": "asked to be verified"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "sum(rate(domain_events_processed_total{type=\"verification.decided\",result=\"ok\"}[15m]))",
          "legendFormat": "decided"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "What is being published",
      "description": "Whether the product is being used, as distinct from whether it is up.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (type) (rate(domain_events_processed_total{type=~\"academic.published|notice.published|event.published\",result=\"ok\"}[15m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fan-out latency percentiles",
      "description": "Published \u2192 every recipient notified. Measured from the moment the domain change committed, so it includes the queue rather than only the handler.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(domain_event_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(domain_event_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Workflow decisions",
      "description": "Leave, complaints, and revocations \u2014 the school-side work the product exists to carry.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (type) (rate(domain_events_processed_total{type=~\"leave.decided|feedback.reviewed|membership.revoked\",result=\"ok\"}[15m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Sign-in failure rate (5m)",
      "description": "A business signal and a security one: a spike is either a broken login form or someone guessing passwords.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.6
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(http_request_duration_seconds_count{route=\"/auth/login\",status=\"401\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count{route=\"/auth/login\"}[5m])), 0.0001)"
        }
      ]
    }
  ]
}
