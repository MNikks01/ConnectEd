{
  "__comment": "Dashboard 5 of .docs/Monitoring/01-slos-and-alerts.md \u2014 Core Web Vitals and JS errors, as measured in the browser rather than at the server. Edited as code; Grafana UI edits are discarded on restart. Thresholds are Google's: LCP 2.5s, INP 200ms, CLS 0.1, TTFB 800ms.",
  "uid": "connected-web-rum",
  "title": "ConnectEd \u2014 Web RUM",
  "tags": ["connected", "web"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "LCP p75",
      "description": "Largest Contentful Paint. Google calls under 2.5s good and over 4s poor. p75 rather than p95 because that is the percentile the Core Web Vitals assessment itself uses.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2.5
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(web_vital_seconds_bucket{metric=\"LCP\"}[30m])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "INP p75",
      "description": "Interaction to Next Paint \u2014 how long the page takes to answer a tap. Good under 200ms.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(web_vital_seconds_bucket{metric=\"INP\"}[30m])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "CLS p75",
      "description": "Cumulative Layout Shift \u2014 how much the page moves under the reader. Unitless; good under 0.1.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(web_vital_cls_bucket[30m])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "TTFB p75",
      "description": "Time to First Byte. The only vital the server alone can fix.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.8
              }
            ]
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(web_vital_seconds_bucket{metric=\"TTFB\"}[30m])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LCP p75 by route",
      "description": "Which pages are slow, rather than that some are. `other` is every path not on the known list in `rum.routes.ts` \u2014 a large `other` means the list needs a page adding.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(web_vital_seconds_bucket{metric=\"LCP\"}[30m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TTFB p75 by route",
      "description": "Server-side latency as the browser experienced it \u2014 including DNS, TLS and the network, none of which `http_request_duration_seconds` can see.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(web_vital_seconds_bucket{metric=\"TTFB\"}[30m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Measurements arriving",
      "description": "The health of the pipeline itself. These stop arriving if the beacon breaks, and a dashboard with no data looks the same as a fast site.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (metric) (rate(web_vital_seconds_count[15m]))",
          "legendFormat": "{{metric}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum(rate(web_vital_cls_count[15m]))",
          "legendFormat": "CLS"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Uncaught browser errors",
      "description": "A JavaScript error nobody reports is a page that silently does nothing when clicked.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (route) (rate(web_errors_total[15m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "What the errors said",
      "description": "The message is logged and never made a label \u2014 it is attacker-controlled and unbounded, which is how a metrics bill runs away.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "expr": "{service=\"connected-api\"} |= \"Browser error reported\""
        }
      ]
    }
  ]
}
