// ConnectEd — Prisma schema v1.
//
// Mirrors `.docs/Database/01-schema.md`. Conventions from `.docs/Database/00-overview.md`:
//   - surrogate uuid PKs; human names are attributes, never keys (the legacy app used name-as-path)
//   - created_at / updated_at on every table; deleted_at (soft delete) on user content
//   - closed sets are DB enums, mirrored in packages/types
//   - FK columns indexed, plus composite indexes for the hot queries called out in the doc
//
// School-scoped rows reference `school_profile.account_id` rather than `account.id`, so the database
// itself guarantees the target is a SCHOOL account — an individual account has no school_profile row.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in the driver adapter
// (runtime), not here. See ADR-0013.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AccountType {
  INDIVIDUAL
  SCHOOL
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserRole {
  STUDENT
  PARENT
  TEACHER
  PRINCIPAL
  USER
}

enum Medium {
  ENGLISH
  HINDI
}

enum ClassLevel {
  PRE_NURSERY
  NURSERY
  KG1
  KG2
  CLASS_1
  CLASS_2
  CLASS_3
  CLASS_4
  CLASS_5
  CLASS_6
  CLASS_7
  CLASS_8
  CLASS_9
  CLASS_10
  CLASS_11
  CLASS_12
}

enum Section {
  A
  B
  C
  D
  E
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

enum AcademicItemType {
  HOMEWORK
  ASSIGNMENT
  PROJECT
}

enum LeaveStatus {
  RECEIVED
  ACCEPTED
  REJECTED
}

enum LeaveKind {
  STUDENT
  TEACHER
}

enum FeedbackKind {
  COMPLAINT
  SUGGESTION
}

enum FeedbackStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Who may see the parts of a profile beyond the name-and-avatar card.
///
/// The card is always visible to a signed-in account — without it nobody could find anyone to
/// connect with, and a "private" profile that cannot be discovered is a profile that cannot be
/// used. Everything else — bio, achievements, date of birth — follows this setting.
/// What a report is about. Loose ids rather than four nullable FKs, matching how `ReadReceipt`
/// already models a polymorphic subject.
enum ReportSubject {
  POST
  COMMENT
  MESSAGE
  ACCOUNT
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

enum ProfileVisibility {
  PUBLIC
  CONNECTIONS
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

/// Polymorphic target of a read receipt. Kept as an enum + loose id rather than one join table per
/// content type, matching the legacy VIEWED_BY[] semantics without the array.
enum ReadReceiptSubject {
  NOTICE
  ACADEMIC_ITEM
  EVENT
  TIMETABLE
}

enum NotificationCategory {
  ACADEMIC
  NOTICE
  EVENT
  LEAVE
  SOCIAL
  MESSAGE
  VERIFICATION
  BILLING
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ---------------------------------------------------------------------------
// Identity & accounts
// ---------------------------------------------------------------------------

model Account {
  id              String        @id @default(uuid()) @db.Uuid
  type            AccountType
  email           String        @unique
  emailVerifiedAt DateTime?     @map("email_verified_at")
  status          AccountStatus @default(ACTIVE)
  /// ConnectEd staff, for the moderation queue and nothing else (ADR-0017).
  ///
  /// A column rather than a `UserRole`: that enum is the *academic* role, scoped to a school
  /// membership, and a platform admin is not a member of anything. It is also deliberately not a
  /// claim in the access token — the policy re-reads it per request, so revoking it takes effect
  /// immediately rather than whenever the holder's token happens to expire.
  isPlatformAdmin Boolean       @default(false) @map("is_platform_admin")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  credential          Credential?
  userProfile         UserProfile?
  schoolProfile       SchoolProfile?
  refreshTokens       RefreshToken[]
  passwordResets      PasswordResetToken[]
  twoFactorSecret     TwoFactorSecret?
  twoFactorChallenges TwoFactorChallenge[]

  teacherProfiles      TeacherProfile[]
  children             Child[]
  memberships          Membership[]
  verificationRequests VerificationRequest[] @relation("VerificationRequester")
  academicItems        AcademicItem[]
  notices              Notice[]
  leaveApplications    LeaveApplication[]
  feedback             Feedback[]
  readReceipts         ReadReceipt[]
  posts                Post[]
  postLikes            PostLike[]
  postComments         PostComment[]
  following            Follow[]              @relation("Follower")
  followers            Follow[]              @relation("Followee")
  connectionsInitiated Connection[]          @relation("ConnectionA")
  connectionsReceived  Connection[]          @relation("ConnectionB")
  threadsAsA           MessageThread[]       @relation("ThreadParticipantA")
  threadsAsB           MessageThread[]       @relation("ThreadParticipantB")
  messagesSent         Message[]
  notifications        Notification[]
  notificationPrefs    NotificationPref[]
  pushTokens           PushToken[]
  mediaObjects         MediaObject[]
  blocksMade           Block[]               @relation("Blocker")
  blocksReceived       Block[]               @relation("Blocked")
  reportsMade          Report[]              @relation("Reporter")

  reportsReviewed Report[] @relation("ReportReviewer")

  @@index([type])
  // Partial-index-shaped in intent: the queue's authorization check is the only reader, and there
  // will be a handful of these rows against every account in the product.
  @@index([isPlatformAdmin])
  @@map("account")
}

/// Password material, split from `account` so an account read never drags the hash along.
/// Plaintext passwords are never stored or logged (`apps/api/CLAUDE.md` rule 7).
model Credential {
  accountId    String   @id @map("account_id") @db.Uuid
  passwordHash String   @map("password_hash")
  /// e.g. "argon2id" — recorded so hashes can be re-hashed when parameters change.
  algo         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credential")
}

/// Rotating refresh tokens (ADR-0007). `familyId` groups a rotation chain so detecting reuse of an
/// already-rotated token can revoke the whole family.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([familyId])
  @@map("refresh_token")
}

/// A single-use, expiring password-reset token (FR-AUTH-009).
///
/// **The token itself is never stored** — only its SHA-256, exactly as refresh tokens are handled.
/// A reset token is a credential that grants an account, and a database dump should not hand one
/// over; hashing means a leaked row buys nothing.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Set the moment it is spent. Single use is enforced on this column, not by deleting the row:
  /// a spent token that is presented again should be *recognised* as spent rather than looking
  /// like one that never existed.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

/// Failed-login throttling, per address (FR-AUTH-011).
///
/// **Keyed on a hash of the email, and kept whether or not an account exists.** Throttling only
/// real addresses would make the throttle itself an account-enumeration oracle: an attacker would
/// learn which addresses are registered by noticing which ones start refusing.
///
/// The IP-based limiter in front of the auth routes is a different control. It stops one machine
/// hammering the API; it does nothing about one account attacked from a thousand machines, which
/// is what a credential-stuffing list is for.
model LoginThrottle {
  /// SHA-256 of the lowercased address. The address itself is not stored: this table would
  /// otherwise become a list of everyone who has ever mistyped a password here.
  emailHash    String    @id @map("email_hash")
  failedCount  Int       @default(0) @map("failed_count")
  /// When the backoff expires. Never null-and-permanent — a lockout that does not lift is a
  /// denial of service against any account whose address somebody knows.
  blockedUntil DateTime? @map("blocked_until")
  lastFailedAt DateTime  @default(now()) @map("last_failed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// The sweep reads this; nothing else does.
  @@index([lastFailedAt])
  @@map("login_throttle")
}

/// TOTP enrolment for the accounts that hold a school's contract and its verification queue
/// (FR-AUTH-012).
///
/// **The secret is encrypted at rest**, not merely stored. A TOTP secret is the whole of the
/// second factor: a database dump containing it in the clear turns two-factor authentication back
/// into one. The key lives in configuration and never in this table, so a dump alone is not
/// enough.
model TwoFactorSecret {
  accountId   String    @id @map("account_id") @db.Uuid
  /// AES-256-GCM, as `iv:tag:ciphertext` in base64url.
  secret      String
  /// Null until a first correct code proves the authenticator actually has the secret. An
  /// enrolment that is trusted before that locks people out of their own accounts when the QR
  /// scan silently failed.
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recoveryCodes RecoveryCode[]

  @@map("two_factor_secret")
}

/// One-time codes for when the phone is lost. Stored hashed, like every other credential here.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  secret TwoFactorSecret @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
  @@map("recovery_code")
}

/// The gap between "your password was right" and "and so was your code".
///
/// Short-lived and single-use. It is not a session and grants nothing: presenting one only earns
/// the right to be asked for a code.
model TwoFactorChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("two_factor_challenge")
}

model UserProfile {
  accountId     String            @id @map("account_id") @db.Uuid
  fullName      String            @map("full_name")
  handle        String            @unique
  mobile        String?
  gender        String?
  dob           DateTime?         @db.Date
  bio           String?
  displayPicKey String?           @map("display_pic_key")
  achievements  String?
  role          UserRole          @default(USER)
  visibility    ProfileVisibility @default(PUBLIC)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([role])
  @@map("user_profile")
}

/// Institution accounts are web-only (enforced at login, not here).
model SchoolProfile {
  accountId         String   @id @map("account_id") @db.Uuid
  name              String
  adminName         String?  @map("admin_name")
  phone             String?
  addressLine1      String?  @map("address_line1")
  addressLine2      String?  @map("address_line2")
  city              String?
  state             String?
  postalCode        String?  @map("postal_code")
  country           String?
  about             String?
  mission           String?
  vision            String?
  facilities        String?
  establishmentYear Int?     @map("establishment_year")
  affiliation       String?
  displayPicKey     String?  @map("display_pic_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  classes              Class[]
  teacherProfiles      TeacherProfile[]
  children             Child[]
  memberships          Membership[]
  verificationRequests VerificationRequest[]
  notices              Notice[]
  events               Event[]
  leaveApplications    LeaveApplication[]
  feedback             Feedback[]
  subscription         Subscription?

  @@index([name])
  @@map("school_profile")
}

// ---------------------------------------------------------------------------
// Institution & academics structure
// ---------------------------------------------------------------------------

/// Replaces the legacy `classKey` string ("EngClass8SecA"); the key is derived for display only.
model Class {
  id        String     @id @default(uuid()) @db.Uuid
  schoolId  String     @map("school_id") @db.Uuid
  medium    Medium
  level     ClassLevel
  section   Section
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  school SchoolProfile @relation(fields: [schoolId], references: [accountId], onDelete: Cascade)

  subjects             Subject[]
  classTeacher         ClassTeacher?
  children             Child[]
  memberships          Membership[]
  academicItems        AcademicItem[]
  timetables           Timetable[]
  leaveApplications    LeaveApplication[]
  verificationRequests VerificationRequest[]

  @@unique([schoolId, medium, level, section])
  @@index([schoolId])
  @@map("class")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  allocations      SubjectAllocation[]
  academicItems    AcademicItem[]
  syllabusProgress SyllabusProgress[]
  timetablePeriods TimetablePeriod[]

  @@unique([classId, name])
  @@index([classId])
  @@map("subject")
}

model TeacherProfile {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  school  SchoolProfile @relation(fields: [schoolId], references: [accountId], onDelete: Cascade)

  allocations  SubjectAllocation[]
  classTeacher ClassTeacher[]

  @@unique([accountId, schoolId])
  @@index([schoolId])
  @@map("teacher_profile")
}

/// Backs "can this teacher publish to this subject?" (`.docs/Database/03-rbac-data.md`).
model SubjectAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([subjectId])
  @@map("subject_allocation")
}

/// `classId` is unique, which is the integrity guard for "at most one class teacher per class".
model ClassTeacher {
  classId     String   @id @map("class_id") @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid
  allocatedAt DateTime @default(now()) @map("allocated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("class_teacher")
}

/// A parent's child. Not an account — children do not log in; the parent acts within their scope.
model Child {
  id              String    @id @default(uuid()) @db.Uuid
  parentAccountId String    @map("parent_account_id") @db.Uuid
  fullName        String    @map("full_name")
  schoolId        String?   @map("school_id") @db.Uuid
  classId         String?   @map("class_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  parent Account        @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  school SchoolProfile? @relation(fields: [schoolId], references: [accountId], onDelete: SetNull)
  class  Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)

  memberships          Membership[]
  verificationRequests VerificationRequest[]
  leaveApplications    LeaveApplication[]

  @@index([parentAccountId])
  @@index([classId])
  @@map("child")
}

// ---------------------------------------------------------------------------
// Membership & verification
// ---------------------------------------------------------------------------

model VerificationRequest {
  id                 String             @id @default(uuid()) @db.Uuid
  requesterAccountId String             @map("requester_account_id") @db.Uuid
  schoolId           String             @map("school_id") @db.Uuid
  role               UserRole
  classId            String?            @map("class_id") @db.Uuid
  childId            String?            @map("child_id") @db.Uuid
  status             VerificationStatus @default(PENDING)
  decidedBy          String?            @map("decided_by") @db.Uuid
  decidedAt          DateTime?          @map("decided_at")
  payload            Json?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  requester Account       @relation("VerificationRequester", fields: [requesterAccountId], references: [id], onDelete: Cascade)
  school    SchoolProfile @relation(fields: [schoolId], references: [accountId], onDelete: Cascade)
  class     Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  child     Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([requesterAccountId])
  @@index([schoolId, status])
  @@map("verification_request")
}

/// The row every academic authorization check reads: it scopes an account to a
/// (school, role, class?, child?) and records whether that scope is VERIFIED.
model Membership {
  id        String             @id @default(uuid()) @db.Uuid
  accountId String             @map("account_id") @db.Uuid
  schoolId  String             @map("school_id") @db.Uuid
  role      UserRole
  classId   String?            @map("class_id") @db.Uuid
  childId   String?            @map("child_id") @db.Uuid
  /// Non-null stand-in for (class_id, child_id) in the unique constraint below.
  ///
  /// `.docs/Database/03-rbac-data.md` names UNIQUE(account_id, school_id, role, class_id, child_id)
  /// as the guard against duplicate/ambiguous scopes — but Postgres treats NULLs as *distinct*, so
  /// that constraint would not have stopped duplicate PRINCIPAL or TEACHER memberships, which carry
  /// no class or child. Those are the rows with the most authority. Postgres 15+ could express this
  /// with NULLS NOT DISTINCT, but Prisma cannot emit it, and hand-written partial indexes would be
  /// reverted by every later `migrate dev`.
  ///
  /// Always derive this with `membershipScopeKey()` — never set it by hand.
  scopeKey  String             @map("scope_key")
  status    VerificationStatus @default(PENDING)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  school  SchoolProfile @relation(fields: [schoolId], references: [accountId], onDelete: Cascade)
  class   Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  child   Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@unique([accountId, schoolId, role, scopeKey])
  @@index([accountId, status])
  @@index([classId, status])
  @@index([schoolId])
  @@map("membership")
}

// ---------------------------------------------------------------------------
// Academic content
// ---------------------------------------------------------------------------

model AcademicItem {
  id              String           @id @default(uuid()) @db.Uuid
  type            AcademicItemType
  classId         String           @map("class_id") @db.Uuid
  subjectId       String           @map("subject_id") @db.Uuid
  authorAccountId String           @map("author_account_id") @db.Uuid
  title           String
  body            String
  imageKey        String?          @map("image_key")
  dueAt           DateTime?        @map("due_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author  Account @relation(fields: [authorAccountId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
  @@index([subjectId])
  @@index([authorAccountId])
  @@map("academic_item")
}

model Notice {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  authorAccountId String    @map("author_account_id") @db.Uuid
  title           String
  body            String
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  school SchoolProfile @relation(fields: [schoolId], references: [accountId], onDelete: Cascade)
  author Account       @relation(fields: [authorAccountId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([authorAccountId])
  @@map("notice")
}

model Event {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  title     String
  body      String
  eventAt   DateTime  @map("event_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school SchoolProfile @relation(fields: [schoolId], references: [accountId], onDelete: Cascade)

  @@index([schoolId, eventAt])
  @@map("event")
}

/// A day a timetable period can fall on. Seven, not five: a six-day week with a half-day Saturday
/// is ordinary in the schools this product is built for.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Timetable {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  /// Null for a structured version (FR-ACAD-021). A version is one or the other, never both —
  /// enforced in the service, because "exactly one of these two columns" is not a constraint
  /// Prisma can express and a CHECK would be reverted by the next `migrate dev`.
  imageKey  String?  @map("image_key")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class   Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  periods TimetablePeriod[]

  @@unique([classId, version])
  @@index([classId])
  @@map("timetable")
}

/// One period of a structured timetable.
///
/// Times are `HH:MM` strings rather than `time` or `DateTime`, deliberately. A period starts at
/// nine in the morning wherever the school is; giving it a timezone is how a timetable ends up
/// shifting by an hour twice a year. Zero-padded, so they compare as their own times.
model TimetablePeriod {
  id          String  @id @default(uuid()) @db.Uuid
  timetableId String  @map("timetable_id") @db.Uuid
  day         Weekday
  startsAt    String  @map("starts_at")
  endsAt      String  @map("ends_at")
  /// A subject of this class, or null when the period is a break, an assembly or games.
  subjectId   String? @map("subject_id") @db.Uuid
  /// The name for a period that is not a subject. Exactly one of this and `subjectId` is set.
  label       String?

  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([timetableId])
  @@index([subjectId])
  @@map("timetable_period")
}

model SyllabusProgress {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  topic     String
  percent   Int      @default(0)
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, topic])
  @@index([subjectId])
  @@map("syllabus_progress")
}

/// Every object written to the bucket, so the ones nothing ever referenced can be found again.
///
/// An upload and the row that references it are two requests: the client uploads, gets a key, and
/// then attaches it. When the second request fails — a validation error, a closed tab, a dropped
/// connection — the object stays in the bucket with nothing pointing at it and no way to identify
/// it later. This table is that way: unclaimed rows older than the grace period are swept.
model MediaObject {
  key         String    @id
  prefix      String
  contentType String    @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  /// Who uploaded it. Kept for the audit trail on a deletion, not for authorization.
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  /// Set when a module attaches the key to something. Null means nothing references it yet.
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  uploader Account @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  /// The sweep's query: unclaimed, oldest first.
  @@index([claimedAt, createdAt])
  @@map("media_object")
}

/// Replaces the legacy VIEWED_BY[] arrays. The unique constraint makes "mark as read" idempotent.
model ReadReceipt {
  id          String             @id @default(uuid()) @db.Uuid
  subjectType ReadReceiptSubject @map("subject_type")
  subjectId   String             @map("subject_id") @db.Uuid
  accountId   String             @map("account_id") @db.Uuid
  readAt      DateTime           @default(now()) @map("read_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([subjectType, subjectId, accountId])
  @@index([accountId])
  @@map("read_receipt")
}

