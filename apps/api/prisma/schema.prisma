model Post {
  id              String    @id @default(uuid()) @db.Uuid
  authorAccountId String    @map("author_account_id") @db.Uuid
  body            String
  imageKey        String?   @map("image_key")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  author Account @relation(fields: [authorAccountId], references: [id], onDelete: Cascade)

  likes    PostLike[]
  comments PostComment[]

  @@index([authorAccountId, createdAt])
  @@map("post")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId])
  @@index([accountId])
  @@map("post_like")
}

model PostComment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([accountId])
  @@map("post_comment")
}

/// One account has blocked another (`PRD/06-social.md`, Moderation & safety).
///
/// Stored directional — who blocked whom — and applied **both ways** on read: a blocked account
/// must not see the blocker's content either, or blocking becomes a one-sided mute that the other
/// party can work around by simply looking.
/// A report raised by a member about content or an account (`PRD/06-social.md`, Moderation).
///
/// **Read by platform admins only** (ADR-0017). Not the school and not the principal: a report is
/// often *about* someone at the reporter's school, and the product promises in as many words that
/// nobody there is told. The rows had accumulated unread since S4-8, so whoever reviews them
/// inherits the history rather than starting from nothing.
model Report {
  id                String        @id @default(uuid()) @db.Uuid
  reporterAccountId String        @map("reporter_account_id") @db.Uuid
  subjectType       ReportSubject @map("subject_type")
  subjectId         String        @map("subject_id") @db.Uuid
  reason            String
  status            ReportStatus  @default(OPEN)
  reviewedBy        String?       @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?     @map("reviewed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  reporter Account  @relation("Reporter", fields: [reporterAccountId], references: [id], onDelete: Cascade)
  /// The reviewer is `SetNull` rather than `Cascade`: a staff account being deleted must not take
  /// the decisions it made with it.
  reviewer Account? @relation("ReportReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  /// One report per person per thing: reporting twice is the same complaint, not two.
  @@unique([reporterAccountId, subjectType, subjectId])
  @@index([status, createdAt])
  @@map("report")
}

model Block {
  id               String   @id @default(uuid()) @db.Uuid
  blockerAccountId String   @map("blocker_account_id") @db.Uuid
  blockedAccountId String   @map("blocked_account_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  blocker Account @relation("Blocker", fields: [blockerAccountId], references: [id], onDelete: Cascade)
  blocked Account @relation("Blocked", fields: [blockedAccountId], references: [id], onDelete: Cascade)

  @@unique([blockerAccountId, blockedAccountId])
  @@index([blockedAccountId])
  @@map("block")
}

model Follow {
  id                String   @id @default(uuid()) @db.Uuid
  followerAccountId String   @map("follower_account_id") @db.Uuid
  followeeAccountId String   @map("followee_account_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  follower Account @relation("Follower", fields: [followerAccountId], references: [id], onDelete: Cascade)
  followee Account @relation("Followee", fields: [followeeAccountId], references: [id], onDelete: Cascade)

  @@unique([followerAccountId, followeeAccountId])
  @@index([followeeAccountId])
  @@map("follow")
}

/// Symmetric relationship. Services must order the pair (a < b) before writing, so the unique
/// constraint cannot be bypassed by swapping the two ids.
model Connection {
  id          String           @id @default(uuid()) @db.Uuid
  aAccountId  String           @map("a_account_id") @db.Uuid
  bAccountId  String           @map("b_account_id") @db.Uuid
  status      ConnectionStatus @default(PENDING)
  requestedBy String           @map("requested_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  a Account @relation("ConnectionA", fields: [aAccountId], references: [id], onDelete: Cascade)
  b Account @relation("ConnectionB", fields: [bAccountId], references: [id], onDelete: Cascade)

  @@unique([aAccountId, bAccountId])
  @@index([bAccountId, status])
  @@map("connection")
}

model MessageThread {
  id           String   @id @default(uuid()) @db.Uuid
  participantA String   @map("participant_a") @db.Uuid
  participantB String   @map("participant_b") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  a Account @relation("ThreadParticipantA", fields: [participantA], references: [id], onDelete: Cascade)
  b Account @relation("ThreadParticipantB", fields: [participantB], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([participantA, participantB])
  @@index([participantB])
  @@map("message_thread")
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  threadId        String    @map("thread_id") @db.Uuid
  senderAccountId String    @map("sender_account_id") @db.Uuid
  body            String
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender Account       @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderAccountId])
  @@map("message")
}

// ---------------------------------------------------------------------------
// Notifications & billing
// ---------------------------------------------------------------------------

model Notification {
  id                 String    @id @default(uuid()) @db.Uuid
  recipientAccountId String    @map("recipient_account_id") @db.Uuid
  /// Free-form because notification types grow per module; the closed set is the *category* below.
  type               String
  payload            Json?
  readAt             DateTime? @map("read_at")
  /// Idempotency key for the async fan-out, unique **per recipient** (see the constraint below).
  /// One event fans out to many people, so a globally unique event id would let the first
  /// recipient's row block everyone else's — which is how a class of thirty gets one notification.
  eventId            String?   @map("event_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  recipient Account @relation(fields: [recipientAccountId], references: [id], onDelete: Cascade)

  /// `.docs/PRD/07-notifications.md`: "idempotent by (event_id, recipient_id)". A redelivered
  /// event is therefore a no-op per person rather than a duplicate in their list.
  @@unique([eventId, recipientAccountId])
  @@index([recipientAccountId, readAt])
  @@map("notification")
}

model NotificationPref {
  id        String               @id @default(uuid()) @db.Uuid
  accountId String               @map("account_id") @db.Uuid
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, category])
  @@map("notification_pref")
}

model PushToken {
  id         String         @id @default(uuid()) @db.Uuid
  accountId  String         @map("account_id") @db.Uuid
  platform   DevicePlatform
  token      String         @unique
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("push_token")
}

model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  limits    Json?
  features  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plan")
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @unique @map("school_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus @default(TRIALING)
  periodStart DateTime           @map("period_start")
  periodEnd   DateTime           @map("period_end")
  providerRef String?            @map("provider_ref")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  school SchoolProfile @relation(fields: [schoolId], references: [accountId], onDelete: Cascade)
  plan   Plan          @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@map("subscription")
}

/// Append-only record of authorization-relevant decisions (`.docs/Database/03-rbac-data.md`):
/// verification decisions, membership revocations, class-teacher allocation, leave decisions,
/// role changes, subscription changes. No FK on the actor so the trail survives account deletion.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([actorAccountId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
