# ConnectEd — environment variables (copy to .env for local dev).
# NEVER commit real secrets. .env is gitignored. Production values come from a secrets manager.

# ---- Core ----
NODE_ENV=development

# ---- API (apps/api) ----
API_PORT=4000
# App base URLs (CORS / links)
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Serves /metrics for Prometheus. Network-level restriction is handled by the infra.
METRICS_ENABLED=true

# ---- Database (PostgreSQL) ----
# matches docker-compose service "postgres"
DATABASE_URL=postgresql://connected:connected@localhost:5432/connected?schema=public

# ---- Redis (cache / queue / rate-limit) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Access-token signing. Minimum 32 characters — the API refuses to boot on anything shorter.
# Asymmetric signing (RS256/EdDSA + JWKS) is the documented target; see ADR-0007.
JWT_ACCESS_SECRET=dev-only-change-me-this-is-32-chars-min
# Seconds, not duration strings: one unambiguous unit beats parsing "15m" three different ways.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# argon2id tuning (safe defaults; tune per host)
ARGON_MEMORY_KIB=19456
ARGON_ITERATIONS=2
ARGON_PARALLELISM=1
# Refresh cookie Secure flag. Forced true in production regardless of this value.
COOKIE_SECURE=false

# ---- Object storage (S3-compatible; MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=connected-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---- Observability (optional locally) ----
# Tracing stays off unless this endpoint is set, so a local run without a collector is quiet.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=connected-api

# ---- Providers (fill when integrating; leave blank locally) ----
PAYMENT_PROVIDER=            # stripe | razorpay
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=

# ---- Database logging ----
# Logs every SQL statement locally. Never enable in production — query text is PII-adjacent.
DB_LOG_QUERIES=false

# Ship API logs to Loki locally (the API runs on the host, so nothing collects its stdout).
# Leave empty in deployed environments — the platform collects container stdout instead.
LOKI_URL=http://localhost:3100
